# Local: path to the service-account JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
# Vercel / serverless: paste the full service-account JSON as a single-line env value
# GOOGLE_SERVICE_ACCOUNT_KEY_JSON={"type":"service_account",...}

# Remplis automatiquement par : node scripts/setup-calendars.js email@gmail.com "Coiffeur 1" "Coiffeur 2" ...
# CALENDAR_ID_COIFFEUR_1=
# CALENDAR_ID_COIFFEUR_2=

# Supabase (server-side only — never expose SUPABASE_SECRET_KEY to the frontend)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

PORT=3001
